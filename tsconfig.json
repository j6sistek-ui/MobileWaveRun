{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "illustrated-src/game",
    "outDir": "dist/js",
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": true,
    "newLine": "lf"
  },
  "include": ["illustrated-src/game/**/*.ts"]
}
